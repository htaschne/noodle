# Copy to .env in the repository root and keep it private.

# RabbitMQ. Use a random hex password for a new local broker.
RABBITMQ_USER=noodle
RABBITMQ_PASSWORD=
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@localhost:5672/

# Local Moodle demo. Use a random hex database password and strong Moodle passwords.
DEMO_MOODLE_DB_PASSWORD=
DEMO_MOODLE_ADMIN_PASSWORD=
DEMO_MOODLE_STUDENT_PASSWORD=

# Optional when reusing an existing demo's separate RabbitMQ account.
# DEMO_RABBITMQ_USER=
# DEMO_RABBITMQ_PASSWORD=
# DEMO_RABBITMQ_URL=

# Personal monitoring. Set api to check submissions or ical for calendar deadlines.
# auto uses iCalendar when its URL is set and the personal API otherwise.
MOODLE_SOURCE=auto
MOODLE_URL=
MOODLE_USERNAME=
MOODLE_PASSWORD=
MOODLE_SERVICE=moodle_mobile_app
NOTIFICATION_EMAIL=

# Generate an export URL for all events in Moodle's calendar export screen.
# The URL includes an authentication token. Keep it in .env.
MOODLE_ICAL_URL=
MOODLE_ICAL_EMAIL=
MOODLE_ICAL_TIMEZONE=America/Sao_Paulo

# Personal polling interval. The demo polls every minute.
MONITOR_INTERVAL=1h
LOG_LEVEL=info
