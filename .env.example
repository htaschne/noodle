# Moodle
# auto: use iCalendar when its URL is set, otherwise the personal API.
# api: check the signed-in student's submission status (recommended).
# ical: calendar-only deadline reminders; submission status is unavailable.
MOODLE_SOURCE=auto
MOODLE_URL=https://moodle.pucrs.br
MOODLE_USERNAME=
MOODLE_PASSWORD=
MOODLE_SERVICE=moodle_mobile_app
MOODLE_TOKEN=
# Your reminder email; required for personal API mode. No class roster needed.
NOTIFICATION_EMAIL=

# Moodle calendar (used in auto/ical mode; API credentials are then optional)
# 1. Log into your university's Moodle.
# 2. Open Calendário.
# 3. Find Exportar calendário.
# 4. Select all events and the recent/upcoming time range.
# 5. Generate or copy the calendar export URL.
# 6. Paste it into MOODLE_ICAL_URL in .env.
# The URL contains an authentication token: treat it as a secret; never commit it.
MOODLE_ICAL_URL=
# Feed owner's recipient; falls back to NOTIFICATION_EMAIL if empty.
MOODLE_ICAL_EMAIL=
# IANA timezone for all-day/floating times; X-WR-TIMEZONE in the feed takes precedence.
MOODLE_ICAL_TIMEZONE=America/Sao_Paulo

# Monitoring
MONITOR_INTERVAL=1h
LOG_LEVEL=info

# RabbitMQ
RABBITMQ_USER=noodle
RABBITMQ_PASSWORD=noodles_secret_password
RABBITMQ_URL=amqp://noodle:noodles_secret_password@localhost:5672/

# Notifications
SMTP_HOST=mailpit
SMTP_PORT=1025
