meta {
  name: Get Submissions
  type: http
  seq: 5
}

post {
  url: {{process.env.MOODLE_URL}}/webservice/rest/server.php
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  wstoken: {{process.env.MOODLE_TOKEN}}
  wsfunction: mod_assign_get_submissions
  moodlewsrestformat: json
  assignmentids[0]: {{process.env.MOODLE_ASSIGNMENT_ID}}
}
