meta {
  name: Get Enrolled Users
  type: http
  seq: 5
}

post {
  url: {{process.env.MOODLE_URL}}/webservice/rest/server.php
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  wstoken: {{authToken}}
  wsfunction: core_enrol_get_enrolled_users
  moodlewsrestformat: json
  courseid: {{?Course ID}}
}
