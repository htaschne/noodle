meta {
  name: Get Token
  type: http
  seq: 1
}

post {
  url: {{process.env.MOODLE_URL}}/login/token.php
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  username: {{process.env.MOODLE_USERNAME}}
  password: {{process.env.MOODLE_PASSWORD}}
  service: {{process.env.MOODLE_SERVICE}}
}
