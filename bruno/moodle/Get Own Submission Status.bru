meta {
  name: Get Own Submission Status
  type: http
  seq: 7
}

post {
  url: {{process.env.MOODLE_URL}}/webservice/rest/server.php
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  wstoken: {{authToken}}
  wsfunction: mod_assign_get_submission_status
  moodlewsrestformat: json
  assignid: {{?Assignment ID}}
}
