meta {
  name: Get Assignments
  type: http
  seq: 4
}

post {
  url: {{process.env.MOODLE_URL}}/webservice/rest/server.php
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  wstoken: {{authToken}}
  wsfunction: mod_assign_get_assignments
  moodlewsrestformat: json
  courseids[0]: {{?Course ID}}
}
